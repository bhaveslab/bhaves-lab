# Stripe Checkout (api/create-checkout-session.ts)
STRIPE_SECRET_KEY=

# Meridian intake notification (api/meridian-intake.ts)
# Resend API key for the account with meridiangtn.com verified as a sending domain.
RESEND_API_KEY=
# Optional — sender shown on the notification email. Must be on a domain verified in Resend.
MERIDIAN_INTAKE_FROM="Meridian Intake <intake@meridiangtn.com>"

# Public Lab session requests (api/possibility-request.ts)
# Use an existing verified sender; server-only, never VITE_ prefixed.
LAB_BOOKING_FROM=
LAB_BOOKING_TO=
# RESEND_API_KEY above is also required. Request delivery does not confirm a booking.

# Issue #8 ebooks — server-only. Configure preview with Stripe TEST mode only.
EBOOK_RETAIL_APPROVED=false
EBOOK_ALLOW_LIVE_PAYMENTS=false
EBOOK_STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET_EBOOKS=
STRIPE_EBOOK_EN_PRICE_ID=
STRIPE_EBOOK_ES_PRICE_ID=
EBOOK_BLOB_READ_WRITE_TOKEN=
EBOOK_DOWNLOAD_SECRET=
EBOOK_RECEIPT_FROM=
EBOOK_PUBLIC_ORIGIN=
