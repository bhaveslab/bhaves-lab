# The Possibility Game ebook Checkout — server-only
STRIPE_SECRET_KEY=

# Meridian intake notification (api/meridian-intake.ts)
# Resend API key for the account with meridiangtn.com verified as a sending domain.
RESEND_API_KEY=
# Optional — sender shown on the notification email. Must be on a domain verified in Resend.
MERIDIAN_INTAKE_FROM="Meridian Intake <intake@meridiangtn.com>"

# Public Lab session requests (api/possibility-request.ts)
# Use an existing verified sender; server-only, never VITE_ prefixed.
LAB_BOOKING_FROM=
LAB_BOOKING_TO=
# RESEND_API_KEY above is also required. Request delivery does not confirm a booking.

# The Possibility Game — server-only. Verify Stripe TEST mode in Preview first.
EBOOK_RETAIL_APPROVED=false
EBOOK_ALLOW_LIVE_PAYMENTS=false
EBOOK_STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET_EBOOKS=
STRIPE_EBOOK_GAME_PRICE_ID=
EBOOK_BLOB_READ_WRITE_TOKEN=
EBOOK_DOWNLOAD_SECRET=
EBOOK_RECEIPT_FROM=
EBOOK_PUBLIC_ORIGIN=
# Production canonical origin: https://www.bhaveslab.com; Preview: its exact HTTPS origin.

# Archived booking configuration. Do not enable or resume booking development.
# All values server-only; same existing private Blob store and Stripe business account.
BOOKING_ENABLED=false
BOOKING_CALENDAR_WRITE_APPROVED=false
BOOKING_TEST_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Exact owner-approved policy JSON, no default business hours. See docs/paid-booking-implementation.md.
BOOKING_AVAILABILITY_JSON=
BOOKING_DATABASE_URL=
BOOKING_TEST_DATABASE_HOST=
BOOKING_STRIPE_PRICE_ID=
BOOKING_WEBHOOK_SECRET=
BOOKING_ACCESS_SECRET=
BOOKING_RECOVERY_SECRET=

# Optional creator tips (variable contribution Stripe Payment Link, one-time).
# The support invitation remains hidden until this VERIFIED Stripe link is set.
VITE_POSSIBILITY_TIP_URL=
