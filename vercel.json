{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/game",
      "destination": "/sessions",
      "permanent": false
    },
    {
      "source": "/game/:path*",
      "destination": "/sessions",
      "permanent": false
    },
    {
      "source": "/library",
      "destination": "/sessions",
      "permanent": false
    },
    {
      "source": "/library/:path*",
      "destination": "/sessions",
      "permanent": false
    }
  ]
}
