{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/game/",
      "destination": "https://possibility-game.vercel.app/"
    },
    {
      "source": "/game/:path*",
      "destination": "https://possibility-game.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/game",
      "destination": "/game/",
      "permanent": false
    }
  ]
}
